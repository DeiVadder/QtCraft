{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.8.3/macos",
                "CMAKE_MAKE_PROGRAM": "$env{HOME}/Qt/Tools/Ninja/ninja"
            }
        },
        { "name": "debug", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },
        { "name": "deploy", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" } },
        { "name": "profile", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "QC_QML_DEBUG": "ON" } },
        {
            "name": "asan", "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "QC_SANITIZERS": "address;undefined" }
        },
        {
            "name": "tsan", "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "QC_SANITIZERS": "thread" }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug", "jobs": 16 },
        { "name": "release", "configurePreset": "release", "jobs": 16 },
        { "name": "deploy", "configurePreset": "deploy", "jobs": 16 },
        { "name": "profile", "configurePreset": "profile", "jobs": 16 },
        { "name": "asan", "configurePreset": "asan", "jobs": 16 },
        { "name": "tsan", "configurePreset": "tsan", "jobs": 16 }
    ],
    "testPresets": [
        { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
        { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
        { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
        { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true },
          "environment": { "TSAN_OPTIONS": "suppressions=${sourceDir}/tests/tsan.supp halt_on_error=1" } }
    ]
}
