# Textures, atlas, texture packs, icons.
# Included by tests/CMakeLists.txt (decision E-417): paths are relative to tests/, and the test
# properties at the end of that file (labels, costs, required files) apply to these tests.

qc_add_test(test_texture_synthesizer SOURCES textures/test_texture_synthesizer.cpp LIBRARIES qc_clientcore)
# Creature textures (decision E-880): the cow's patches, opaque body textures of every creature.
qc_add_test(test_mob_textures SOURCES textures/test_mob_textures.cpp LIBRARIES qc_base_content qc_clientcore)
qc_add_test(test_texture_packs SOURCES textures/test_texture_packs.cpp LIBRARIES qc_clientcore)
qc_add_test(test_texture_atlas SOURCES textures/test_texture_atlas.cpp LIBRARIES qc_base_content qc_clientcore Qt::Concurrent)
# Animated textures (decision E-878): frames by time, definitions, pack strips, frames in the atlas.
qc_add_test(test_texture_animation SOURCES textures/test_texture_animation.cpp LIBRARIES qc_base_content qc_clientcore)
qc_add_test(test_atlas_fill SOURCES textures/test_atlas_fill.cpp LIBRARIES qc_base_content qc_clientcore)
# Icons of blocks of several cells (decision E-885): the bed with both halves.
qc_add_test(test_block_icons SOURCES textures/test_block_icons.cpp LIBRARIES qc_base_content qc_clientcore)
# The settings' texture pack controller at model level (decision E-301), from the app's library.
qc_add_test(test_texture_pack_controller SOURCES textures/test_texture_pack_controller.cpp LIBRARIES qc_app_core)
# Item icons in QML's pixmap cache (decision E-650): new icons reach shown and newly created images.
qc_add_test(test_item_icon_cache SOURCES textures/test_item_icon_cache.cpp LIBRARIES qc_app_core)
# The hitch window of a texture pack switch in a benchmark run (decision E-332), from the app's library.
qc_add_test(test_pack_switch_hitch SOURCES textures/test_pack_switch_hitch.cpp LIBRARIES qc_app_core)
qc_add_test(test_app_icon SOURCES textures/test_app_icon.cpp LIBRARIES qc_base_content qc_clientcore)
target_compile_definitions(test_app_icon PRIVATE QTCRAFT_SOURCE_DIR="${PROJECT_SOURCE_DIR}")
# Runs qtcraft-headless --export-handbook-web into a temporary directory and checks what it wrote
# (web/handbook/data is generated by the Pages workflow, not committed).
qc_add_test(test_web_handbook SOURCES textures/test_web_handbook.cpp LIBRARIES qc_base_content qc_worlds qc_clientcore Qt::Qml)
target_compile_definitions(test_web_handbook PRIVATE QTCRAFT_SOURCE_DIR="${PROJECT_SOURCE_DIR}"
                                                     QTCRAFT_HEADLESS_PATH="$<TARGET_FILE:qtcraft-headless>")
add_dependencies(test_web_handbook qtcraft-headless)
# The shared atlas texture of the character previews, on the Null backend of QRhi.
qc_add_test(test_preview_atlas_cache SOURCES textures/test_preview_atlas_cache.cpp LIBRARIES qc_app_core)
