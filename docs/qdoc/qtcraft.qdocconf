# The QDoc project of the API documentation (decision E-939). Not run directly: scripts/api-docs.py
# (CMake target `docs`, Pages workflow) stages the headers and QML files with their topic commands,
# writes a configuration with the paths (sources, header folders, output, Qt index files) that
# includes this one and runs qdoc. Plain HTML with an own small stylesheet, no Qt templates (CI has
# no Qt documentation configuration).

project                 = QtCraft
description             = QtCraft API Reference
moduleheader            = QtCraftApi
language                = Cpp
naturallanguage         = en
sourceencoding          = UTF-8
outputencoding          = UTF-8
outputformats           = HTML

# Hand-written pages: the landing page and one page per library and the QML module.
sources                += $QC_QDOC_DIR/src/index.qdoc \
                          $QC_QDOC_DIR/src/modules.qdoc

defines                += Q_QDOC QC_TLS_ENABLED
# Qt Quick's QML_ELEMENT family and the moc keywords mean nothing to the docs.
Cpp.ignoretokens       += Q_INVOKABLE Q_SIGNAL Q_SLOT QML_ELEMENT QML_SINGLETON QML_ANONYMOUS
Cpp.ignoredirectives   += Q_DISABLE_COPY_MOVE Q_DISABLE_COPY Q_ENUM Q_FLAG Q_DECLARE_FLAGS \
                          Q_DECLARE_METATYPE QML_NAMED_ELEMENT QML_UNCREATABLE QML_FOREIGN \
                          Q_CLASSINFO

navigation.landingpage  = "QtCraft API"
navigation.cppclassespage = "All C++ classes"
navigation.qmltypespage = "QML types"

HTML.outputsubdir       = .
HTML.stylesheets        = $QC_QDOC_DIR/style/qtcraft.css
HTML.headerstyles       = "  <link rel=\"stylesheet\" type=\"text/css\" href=\"style/qtcraft.css\" />\n"
HTML.postheader         = "<header class=\"site\"><a href=\"index.html\">QtCraft API</a>" \
                          "<a href=\"classes.html\">C++ classes</a>" \
                          "<a href=\"qtcraft-qmlmodule.html\">QML types</a>" \
                          "<a href=\"../handbook/\">Handbook</a></header>\n<main>\n"
HTML.footer             = "</main>\n<footer class=\"site\">QtCraft API reference, generated by QDoc " \
                          "from the sources. GPL-3.0-or-later.</footer>\n"
