# Build output
/build*/
# build/ as a link to another disk (scripts/ensure-user-presets.sh, ~/.config/qtcraft/build-root)
/build
/out/
CMakeLists.txt.user*
CMakeUserPresets.json
compile_commands.json

# IDE / OS
.qtcreator/
.idea/
.vscode/
.cache/
.DS_Store
._*
*.swp

# Local agent config (the project settings with the clangd plugin and the code map hook are shared)
.claude/*
!.claude/settings.json

# Generated by scripts/code-map.py
/docs/Code-Karte.md
/docs/Entscheidungen-Index.md
deploy/

# Python caches
__pycache__/
*.pyc

# Keys, certificates and local secrets never go into the repository (test keys are made at run time)
*.p12
*.pfx
*.pem
*.key
*.mobileprovision
.env
.env.*

# Qt Creator and editor leftovers
*.autosave
.qmlls.ini

# The web handbook's data: written by scripts/export-handbook.sh (local preview) and by the Pages
# workflow before it publishes web/ (qtcraft-headless --export-handbook-web)
/web/handbook/data/
# The API reference: written by the Pages workflow before it publishes web/ (scripts/api-docs.py
# --out web/api); locally it goes to build/<preset>/docs/api (target docs)
/web/api/
