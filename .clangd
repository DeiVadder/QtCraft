# clangd (editors and the LSP tool of Claude Code, tools/claude-plugins): the compilation database
# of the debug build. Configure it once with `cmake --preset debug`; build once for the moc files.
CompileFlags:
  CompilationDatabase: build/debug
---
# No background index for the worktrees of parallel work packages. Subagents share the clangd of
# the session that started them, and each worktree has its own compilation database: one edit in a
# worktree made that clangd index all ~1400 translation units of it from scratch, for every new
# worktree (README of the plugin qtcraft-clangd). Opened files still get diagnostics and navigation.
If:
  PathMatch: \.claude/worktrees/.*
Index:
  Background: Skip
---
# No background index for sources generated by rcc and qmlcachegen (resources, compiled QML): large
# files without symbols worth finding. The moc files stay indexed (signal definitions).
If:
  PathMatch: build/.*/(\.rcc|\.qt/rcc)/.*
Index:
  Background: Skip
