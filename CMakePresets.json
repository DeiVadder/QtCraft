{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "description": "Shared settings of the local presets; the Qt and Ninja paths of the machine come from the hidden preset 'local' in CMakeUserPresets.json (see CMakeUserPresets.example.json)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        { "name": "qc-debug", "hidden": true, "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        { "name": "qc-release", "hidden": true, "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },
        {
            "name": "qc-deploy", "hidden": true, "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" }
        },
        {
            "name": "qc-profile", "hidden": true, "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "QC_QML_DEBUG": "ON" }
        },
        {
            "name": "qc-asan", "hidden": true, "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "QC_SANITIZERS": "address;undefined" }
        },
        {
            "name": "qc-tsan", "hidden": true, "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "QC_SANITIZERS": "thread" }
        },
        {
            "name": "ci", "hidden": true,
            "description": "GitHub Actions: Qt from QT_ROOT_DIR (install-qt-action), Ninja from PATH",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": { "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}" }
        },
        { "name": "ci-debug", "inherits": "ci", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        {
            "name": "ci-deploy", "inherits": "ci",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64" }
        }
    ],
    "buildPresets": [
        { "name": "qc-build", "hidden": true, "jobs": 16 },
        { "name": "ci-debug", "configurePreset": "ci-debug" },
        { "name": "ci-deploy", "configurePreset": "ci-deploy" }
    ],
    "testPresets": [
        {
            "name": "qc-test", "hidden": true, "output": { "outputOnFailure": true },
            "environment": { "QT_MAC_DISABLE_FOREGROUND_APPLICATION_TRANSFORM": "1" }
        },
        {
            "name": "qc-tsan-test", "hidden": true, "inherits": "qc-test",
            "environment": {
                "QT_MAC_DISABLE_FOREGROUND_APPLICATION_TRANSFORM": "1",
                "TSAN_OPTIONS": "suppressions=${sourceDir}/tests/tsan.supp halt_on_error=1"
            }
        },
        { "name": "ci-debug", "configurePreset": "ci-debug", "output": { "outputOnFailure": true } }
    ]
}
